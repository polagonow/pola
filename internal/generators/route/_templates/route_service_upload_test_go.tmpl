// TestRoute_GET_List exercises the list handler with a stubbed service.
// File-upload routes share the same GET semantics as plain service routes.
func TestRoute_GET_List(t *testing.T) {
	svc := &mock[[ .ServiceName ]]Service{
		listFn: func(ctx context.Context, params repositories.ListParams) (*repositories.ListResult[*repositories.[[ .ServiceName ]]], error) {
			return &repositories.ListResult[*repositories.[[ .ServiceName ]]]{Page: params.Page, PerPage: params.PerPage}, nil
		},
	}
	// store and blobs are nil — GET doesn't exercise them.
	fw := std.New()
	fw.Handle("GET", "[[ .RoutePath ]]", NewRoute(svc, nil, nil).GET)
	w := httptest.NewRecorder()
	fw.Handler().ServeHTTP(w, httptest.NewRequest("GET", "[[ .RoutePath ]]", nil))
	if w.Code != 200 {
		t.Fatalf("status: got %d want 200; body=%q", w.Code, w.Body.String())
	}
}
