package [[ .Package ]]

import (
	"net/http"

	dto "[[ .ModulePath ]]/[[ .DtoDir ]]"
	"[[ .ModulePath ]]/[[ .ModelsDir ]]"
	"[[ .ModulePath ]]/services"
	"github.com/polagonow/pola/core"
	poladto "github.com/polagonow/pola/dto"
	"github.com/polagonow/pola/repository"
	"github.com/polagonow/pola/request"
)

// Route handles [[ .RoutePath ]] requests. Handlers speak DTOs at the boundary:
// requests bind Create/Update DTOs mapped onto the model, and responses convert
// the model to a response DTO (so internal-only columns never leak).
type Route struct {
	svc services.[[ .ServiceName ]]ServiceInterface
}

// NewRoute creates a Route, resolving its dependencies from the DI registry.
func NewRoute(r *core.Registry) *Route {
	return &Route{svc: core.MustInvoke[services.[[ .ServiceName ]]ServiceInterface](r)}
}
[[ if .ExplicitPath ]]
// Path pins the exact URL this route serves.
func (r *Route) Path() string { return "[[ .ExplicitPath ]]" }
[[ end ]]
[[ range .Methods ]]
[[ if eq . "GET" -]]
// GET [[ $.RoutePath ]]
func (r *Route) GET(c core.Context) error {
	if request.PathParam(c, "id") != "" {
[[ if eq $.IDGoType "string" -]]
		entity, err := r.svc.Get(c.Ctx(), request.PathParam(c, "id"))
[[ else -]]
		n, err := request.PathParamUint(c, "id")
		if err != nil {
			return c.JSON(http.StatusBadRequest, core.M{"error": err.Error()})
		}
		entity, err := r.svc.Get(c.Ctx(), n)
[[ end -]]
		if err != nil {
			if repository.IsNotFound(err) {
				return c.JSON(http.StatusNotFound, core.M{"error": err.Error()})
			}
			return c.JSON(http.StatusInternalServerError, core.M{"error": err.Error()})
		}
		return c.JSON(http.StatusOK, poladto.MustConvert[dto.[[ $.ServiceName ]]](entity))
	}

	params := repository.ListParams{
		Page:    request.QueryParamInt(c, "page", 1),
		PerPage: request.QueryParamInt(c, "per_page", repository.DefaultPerPage),
	}
	result, err := r.svc.List(c.Ctx(), params)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, core.M{"error": err.Error()})
	}
	items := make([]dto.[[ $.ServiceName ]], len(result.Items))
	for i, it := range result.Items {
		items[i] = poladto.MustConvert[dto.[[ $.ServiceName ]]](it)
	}
	return c.JSON(http.StatusOK, core.M{
		"items":       items,
		"total":       result.Total,
		"page":        result.Page,
		"per_page":    result.PerPage,
		"total_pages": result.TotalPages,
	})
}
[[ else if eq . "POST" -]]
// POST [[ $.RoutePath ]]
func (r *Route) POST(c core.Context) error {
	var in dto.Create[[ $.ServiceName ]]
	if err := c.Bind(&in); err != nil {
		return err
	}
	var entity [[ $.ModelsPkg ]].[[ $.ServiceName ]]
	poladto.Copy(&entity, in)
	if err := r.svc.Create(c.Ctx(), &entity); err != nil {
		return c.JSON(http.StatusInternalServerError, core.M{"error": err.Error()})
	}
	return c.JSON(http.StatusCreated, poladto.MustConvert[dto.[[ $.ServiceName ]]](&entity))
}
[[ else if eq . "PUT" -]]
// PUT [[ $.RoutePath ]]
func (r *Route) PUT(c core.Context) error {
[[ template "updateBody" $ ]]
}
[[ else if eq . "PATCH" -]]
// PATCH [[ $.RoutePath ]]
func (r *Route) PATCH(c core.Context) error {
[[ template "updateBody" $ ]]
}
[[ else if eq . "DELETE" -]]
// DELETE [[ $.RoutePath ]]
func (r *Route) DELETE(c core.Context) error {
[[ if eq $.IDGoType "string" -]]
	id := request.PathParam(c, "id")
	if id == "" {
		return c.JSON(http.StatusBadRequest, core.M{"error": "missing id"})
	}
[[ else -]]
	id, err := request.PathParamUint(c, "id")
	if err != nil {
		return c.JSON(http.StatusBadRequest, core.M{"error": err.Error()})
	}
[[ end -]]
	if err := r.svc.Delete(c.Ctx(), id); err != nil {
		if repository.IsNotFound(err) {
			return c.JSON(http.StatusNotFound, core.M{"error": err.Error()})
		}
		return c.JSON(http.StatusInternalServerError, core.M{"error": err.Error()})
	}
	return c.NoContent(http.StatusNoContent)
}
[[ else -]]
// [[ . ]] [[ $.RoutePath ]]
func (r *Route) [[ . ]](c core.Context) error {
	// TODO: implement
	return c.JSON(http.StatusOK, core.M{"ok": true})
}
[[ end -]]
[[ end -]]

[[- define "updateBody" -]]
[[ if eq .IDGoType "string" -]]
	id := request.PathParam(c, "id")
	if id == "" {
		return c.JSON(http.StatusBadRequest, core.M{"error": "missing id"})
	}
[[ else -]]
	id, err := request.PathParamUint(c, "id")
	if err != nil {
		return c.JSON(http.StatusBadRequest, core.M{"error": err.Error()})
	}
[[ end -]]
	entity, err := r.svc.Get(c.Ctx(), id)
	if err != nil {
		if repository.IsNotFound(err) {
			return c.JSON(http.StatusNotFound, core.M{"error": err.Error()})
		}
		return c.JSON(http.StatusInternalServerError, core.M{"error": err.Error()})
	}

	var in dto.Update[[ .ServiceName ]]
	if err := c.Bind(&in); err != nil {
		return err
	}
	poladto.Copy(entity, in)
	if err := r.svc.Update(c.Ctx(), entity); err != nil {
		return c.JSON(http.StatusInternalServerError, core.M{"error": err.Error()})
	}
	return c.JSON(http.StatusOK, poladto.MustConvert[dto.[[ .ServiceName ]]](entity))
[[- end -]]
