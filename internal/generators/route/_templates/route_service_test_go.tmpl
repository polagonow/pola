	"github.com/polagonow/pola/webframework/std"
)

// mock[[ .ServiceName ]]Service is a hand-rolled mock satisfying
// services.[[ .ServiceName ]]ServiceInterface. Each method is backed by a
// *Fn field; unset fields panic on call so missing expectations fail loudly.
type mock[[ .ServiceName ]]Service struct {
	createFn func(ctx context.Context, e *repositories.[[ .ServiceName ]]) error
	getFn    func(ctx context.Context, id [[ .IDGoType ]]) (*repositories.[[ .ServiceName ]], error)
	listFn   func(ctx context.Context, params repository.ListParams) (*repository.ListResult[*repositories.[[ .ServiceName ]]], error)
	updateFn func(ctx context.Context, e *repositories.[[ .ServiceName ]]) error
	deleteFn func(ctx context.Context, id [[ .IDGoType ]]) error
}

func (m *mock[[ .ServiceName ]]Service) Create(ctx context.Context, e *repositories.[[ .ServiceName ]]) error {
	if m.createFn == nil {
		panic("createFn not set")
	}
	return m.createFn(ctx, e)
}
func (m *mock[[ .ServiceName ]]Service) Get(ctx context.Context, id [[ .IDGoType ]]) (*repositories.[[ .ServiceName ]], error) {
	if m.getFn == nil {
		panic("getFn not set")
	}
	return m.getFn(ctx, id)
}
func (m *mock[[ .ServiceName ]]Service) List(ctx context.Context, params repository.ListParams) (*repository.ListResult[*repositories.[[ .ServiceName ]]], error) {
	if m.listFn == nil {
		panic("listFn not set")
	}
	return m.listFn(ctx, params)
}
func (m *mock[[ .ServiceName ]]Service) Update(ctx context.Context, e *repositories.[[ .ServiceName ]]) error {
	if m.updateFn == nil {
		panic("updateFn not set")
	}
	return m.updateFn(ctx, e)
}
func (m *mock[[ .ServiceName ]]Service) Delete(ctx context.Context, id [[ .IDGoType ]]) error {
	if m.deleteFn == nil {
		panic("deleteFn not set")
	}
	return m.deleteFn(ctx, id)
}

// serve registers h on a std framework and serves a single request.
func serve(method string, body io.Reader, h core.HandlerFunc) *httptest.ResponseRecorder {
	fw := std.New()
	fw.Handle(method, "[[ .RoutePath ]]", h)
	w := httptest.NewRecorder()
	fw.Handler().ServeHTTP(w, httptest.NewRequest(method, "[[ .RoutePath ]]", body))
	return w
}

[[ range .Methods ]]
[[ if eq . "GET" -]]
func TestRoute_GET_List(t *testing.T) {
	svc := &mock[[ $.ServiceName ]]Service{
		listFn: func(ctx context.Context, params repository.ListParams) (*repository.ListResult[*repositories.[[ $.ServiceName ]]], error) {
			return &repository.ListResult[*repositories.[[ $.ServiceName ]]]{Page: params.Page, PerPage: params.PerPage}, nil
		},
	}
	w := serve("GET", nil, NewRoute(svc).GET)
	if w.Code != 200 {
		t.Fatalf("status: got %d want 200; body=%q", w.Code, w.Body.String())
	}
}
[[ else if eq . "POST" -]]
func TestRoute_POST_BadJSON(t *testing.T) {
	w := serve("POST", strings.NewReader("not-json"), NewRoute(&mock[[ $.ServiceName ]]Service{}).POST)
	if w.Code != 400 {
		t.Fatalf("status: got %d want 400 for bad JSON; body=%q", w.Code, w.Body.String())
	}
}
[[ else if eq . "DELETE" -]]
func TestRoute_DELETE_MissingID(t *testing.T) {
	w := serve("DELETE", nil, NewRoute(&mock[[ $.ServiceName ]]Service{}).DELETE)
	if w.Code != 400 {
		t.Fatalf("status: got %d want 400 for missing id; body=%q", w.Code, w.Body.String())
	}
}
