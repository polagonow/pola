// mock[[ .ServiceName ]]Service is a hand-rolled mock satisfying
// services.[[ .ServiceName ]]ServiceInterface. Each method is backed by a
// *Fn field; unset fields panic on call so missing expectations fail loudly.
type mock[[ .ServiceName ]]Service struct {
	createFn func(ctx context.Context, e *repositories.[[ .ServiceName ]]) error
	getFn    func(ctx context.Context, id [[ .IDGoType ]]) (*repositories.[[ .ServiceName ]], error)
	listFn   func(ctx context.Context, params repositories.ListParams) (*repositories.ListResult[*repositories.[[ .ServiceName ]]], error)
	updateFn func(ctx context.Context, e *repositories.[[ .ServiceName ]]) error
	deleteFn func(ctx context.Context, id [[ .IDGoType ]]) error
}

func (m *mock[[ .ServiceName ]]Service) Create(ctx context.Context, e *repositories.[[ .ServiceName ]]) error {
	if m.createFn == nil {
		panic("createFn not set")
	}
	return m.createFn(ctx, e)
}
func (m *mock[[ .ServiceName ]]Service) Get(ctx context.Context, id [[ .IDGoType ]]) (*repositories.[[ .ServiceName ]], error) {
	if m.getFn == nil {
		panic("getFn not set")
	}
	return m.getFn(ctx, id)
}
func (m *mock[[ .ServiceName ]]Service) List(ctx context.Context, params repositories.ListParams) (*repositories.ListResult[*repositories.[[ .ServiceName ]]], error) {
	if m.listFn == nil {
		panic("listFn not set")
	}
	return m.listFn(ctx, params)
}
func (m *mock[[ .ServiceName ]]Service) Update(ctx context.Context, e *repositories.[[ .ServiceName ]]) error {
	if m.updateFn == nil {
		panic("updateFn not set")
	}
	return m.updateFn(ctx, e)
}
func (m *mock[[ .ServiceName ]]Service) Delete(ctx context.Context, id [[ .IDGoType ]]) error {
	if m.deleteFn == nil {
		panic("deleteFn not set")
	}
	return m.deleteFn(ctx, id)
}

