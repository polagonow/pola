[[ if eq . "GET" -]]
func TestRoute_GET_List(t *testing.T) {
	svc := &mock[[ $.ServiceName ]]Service{
		listFn: func(ctx context.Context, params repositories.ListParams) (*repositories.ListResult[*repositories.[[ $.ServiceName ]]], error) {
			return &repositories.ListResult[*repositories.[[ $.ServiceName ]]]{Page: params.Page, PerPage: params.PerPage}, nil
		},
	}
	r := NewRoute(svc)
	w := httptest.NewRecorder()
	req := httptest.NewRequest("GET", "[[ $.RoutePath ]]", nil)
	r.GET(w, req)
	if w.Code != 200 {
		t.Fatalf("status: got %d want 200; body=%q", w.Code, w.Body.String())
	}
}
[[ else if eq . "POST" -]]
func TestRoute_POST_BadJSON(t *testing.T) {
	svc := &mock[[ $.ServiceName ]]Service{}
	r := NewRoute(svc)
	w := httptest.NewRecorder()
	req := httptest.NewRequest("POST", "[[ $.RoutePath ]]", bytes.NewBufferString("not-json"))
	r.POST(w, req)
	if w.Code != 400 {
		t.Fatalf("status: got %d want 400 for bad JSON; body=%q", w.Code, w.Body.String())
	}
}
