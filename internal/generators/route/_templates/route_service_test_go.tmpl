[[ else if eq . "PATCH" -]]
func TestRoute_PATCH_MissingID(t *testing.T) {
	w := serve("PATCH", strings.NewReader(`{}`), NewRoute(&mock[[ $.ServiceName ]]Service{}).PATCH)
	if w.Code != 400 {
		t.Fatalf("status: got %d want 400 for missing id; body=%q", w.Code, w.Body.String())
	}
}
[[ else -]]
func TestRoute_[[ . ]]_DoesNotPanic(t *testing.T) {
	w := serve("[[ . ]]", nil, NewRoute(&mock[[ $.ServiceName ]]Service{}).[[ . ]])
	_ = w.Result()
}
