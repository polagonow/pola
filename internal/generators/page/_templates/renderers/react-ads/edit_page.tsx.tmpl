import { [[ .ActionName ]] } from "@pola/actions";
import Edit[[ .Name ]]Form from "@/components/[[ .PluralSnake ]]/edit-form";

export default async function Edit[[ .Name ]]Page({
  params,
}: {
  params: { id: string };
}) {
  const id = parseInt(params.id, 10);
  const item = await [[ .ActionName ]].get(id);

  return (
    <div style={{ border: "1px solid var(--ds-border, #DFE1E6)", borderRadius: 3, overflow: "hidden" }}>
      <div style={{ padding: "16px 24px", borderBottom: "1px solid var(--ds-border, #DFE1E6)", background: "var(--ds-background-neutral, #F4F5F7)" }}>
        <h2 style={{ margin: 0, fontSize: "1.125rem", fontWeight: 600 }}>{`Edit [[ .Name ]] #${params.id}`}</h2>
      </div>
      <div style={{ padding: 24 }}>
        <Edit[[ .Name ]]Form id={id} initialData={item} />
      </div>
    </div>
  );
}
