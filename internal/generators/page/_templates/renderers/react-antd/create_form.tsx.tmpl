"use client";

import { useState, useTransition } from "react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { [[ .SnakeName ]]Schema, type [[ .Name ]] } from "[[ .SchemaImport ]]";
import { csrfToken } from "@/utils/csrf";

export default function Create[[ .Name ]]Form() {
  const [error, setError] = useState<string | null>(null);
  const [isPending, startTransition] = useTransition();
  const {
    register,
    handleSubmit,
    formState: { errors },
  } = useForm<[[ .Name ]]>({
    resolver: zodResolver([[ .SnakeName ]]Schema),
  });

  function onSubmit(data: [[ .Name ]]) {
    setError(null);

    startTransition(async () => {
      try {
        const res = await fetch("/[[ .PluralSnake ]]/", {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken() },
          body: JSON.stringify(data),
        });
        if (!res.ok) {
          const text = await res.text();
          throw new Error(text || res.statusText);
        }
        window.location.href = "/[[ .PluralSnake ]]";
      } catch (err) {
        setError(err instanceof Error ? err.message : "An error occurred");
      }
    });
  }

  return (
    <>
      {error && (
        <div style={{ marginBottom: 24, padding: "8px 12px", borderRadius: 8, background: "#fff2f0", border: "1px solid #ffccc7" }}>
          <strong style={{ color: "#ff4d4f" }}>Error</strong>
          <p style={{ margin: "4px 0 0", fontSize: "0.875rem", color: "#ff4d4f" }}>{error}</p>
        </div>
      )}

      <form onSubmit={handleSubmit(onSubmit)}>
        <div style={{ display: "flex", flexDirection: "column", gap: 20 }}>
          [[- range .Fields ]]
          [[ if eq .InputType "checkbox" -]]
          <label style={{ display: "flex", alignItems: "center", gap: 8, cursor: "pointer" }}>
            <input
              type="checkbox"
              {...register("[[ .JSONName ]]")}
              style={{ width: 16, height: 16, accentColor: "#1677ff" }}
            />
            <span style={{ fontSize: "0.875rem", color: "rgba(0, 0, 0, 0.88)" }}>[[ .Label ]][[ if .Optional ]] (optional)[[ end ]]</span>
          </label>
          [[ else -]]
          <div>
            <label htmlFor="[[ .JSONName ]]" style={{ display: "block", marginBottom: 8, fontSize: "0.875rem", fontWeight: 400, color: "rgba(0, 0, 0, 0.88)" }}>
              [[ .Label ]][[ if .Optional ]] <span style={{ color: "rgba(0, 0, 0, 0.45)" }}>(optional)</span>[[ end ]]
            </label>
            [[ if .IsTextarea -]]
            <textarea
              id="[[ .JSONName ]]"
              {...register("[[ .JSONName ]]")}
              rows={4}
              style={{ width: "100%", padding: "4px 11px", borderRadius: 6, border: "1px solid #d9d9d9", fontSize: "0.875rem", fontFamily: "inherit", resize: "vertical", background: "#fff", color: "rgba(0, 0, 0, 0.88)", lineHeight: "1.5714285714285714", boxSizing: "border-box" }}
            />
            [[ else -]]
            <input
              type="[[ .InputType ]]"
              id="[[ .JSONName ]]"
              {...register("[[ .JSONName ]]"[[ if eq .InputType "number" ]], { valueAsNumber: true }[[ end ]])}
              [[ if .IsFloat ]]step="any"[[ end ]]
              style={{ width: "100%", padding: "4px 11px", borderRadius: 6, border: "1px solid #d9d9d9", fontSize: "0.875rem", fontFamily: "inherit", background: "#fff", color: "rgba(0, 0, 0, 0.88)", lineHeight: "1.5714285714285714", boxSizing: "border-box" }}
            />
            [[ end -]]
            {errors.[[ .JSONName ]] && (
              <div style={{ marginTop: 4, fontSize: "0.75rem", color: "#ff4d4f" }}>
                {errors.[[ .JSONName ]]?.message}
              </div>
            )}
          </div>
          [[ end -]]
          [[- end ]]
        </div>

        <div style={{ display: "flex", gap: 8, marginTop: 24 }}>
          <button
            type="submit"
            disabled={isPending}
            style={{ padding: "4px 15px", borderRadius: 6, border: "1px solid #1677ff", background: "#1677ff", color: "#fff", fontWeight: 400, fontSize: "0.875rem", cursor: "pointer", opacity: isPending ? 0.65 : 1, lineHeight: "1.5714285714285714" }}
          >
            {isPending ? "Creating..." : "Create [[ .Name ]]"}
          </button>
          <a
            href="/[[ .PluralSnake ]]"
            style={{ padding: "4px 15px", borderRadius: 6, border: "1px solid #d9d9d9", background: "#fff", color: "rgba(0, 0, 0, 0.88)", fontWeight: 400, fontSize: "0.875rem", textDecoration: "none", display: "inline-flex", alignItems: "center", lineHeight: "1.5714285714285714" }}
          >
            Cancel
          </a>
        </div>
      </form>
    </>
  );
}
