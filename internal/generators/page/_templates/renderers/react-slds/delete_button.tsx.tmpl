"use client";

import { useState, useTransition } from "react";
import { csrfToken } from "@/utils/csrf";

export default function DeleteButton({ id }: { id: number }) {
  const [open, setOpen] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [isPending, startTransition] = useTransition();

  function handleDelete() {
    setError(null);

    startTransition(async () => {
      try {
        const res = await fetch(`/[[ .PluralSnake ]]/${id}`, {
          method: "DELETE",
          headers: { "X-CSRF-Token": csrfToken() },
        });

        if (!res.ok) {
          const text = await res.text();
          throw new Error(text || res.statusText);
        }

        window.location.href = "/[[ .PluralSnake ]]";
      } catch (err) {
        setError(err instanceof Error ? err.message : "Delete failed");
      }
    });
  }

  return (
    <>
      <button
        className="slds-button slds-button_destructive"
        onClick={() => setOpen(true)}
        disabled={isPending}
      >
        {isPending ? "Deleting..." : "Delete"}
      </button>

      {open && (
        <div role="dialog" aria-modal="true" className="slds-modal slds-fade-in-open">
          <div className="slds-modal__container">
            <button className="slds-button slds-button_icon slds-modal__close slds-button_icon-inverse" onClick={() => setOpen(false)}>
              <svg className="slds-button__icon slds-button__icon_large" aria-hidden="true">
                <use xlinkHref="/assets/icons/utility-sprite/svg/symbols.svg#close"></use>
              </svg>
              <span className="slds-assistive-text">Close</span>
            </button>
            <div className="slds-modal__header slds-theme_error slds-theme_alert-texture">
              <h2 className="slds-text-heading_medium">Delete [[ .Name ]]</h2>
            </div>
            <div className="slds-modal__content slds-p-around_medium">
              <p>Are you sure you want to delete this [[ .SnakeName ]]? This action cannot be undone.</p>
              {error && (
                <div className="slds-notify slds-notify_alert slds-alert_error slds-m-top_small" role="alert">
                  <h2>{error}</h2>
                </div>
              )}
            </div>
            <div className="slds-modal__footer">
              <button className="slds-button slds-button_neutral" onClick={() => setOpen(false)} disabled={isPending}>
                Cancel
              </button>
              <button className="slds-button slds-button_destructive" onClick={handleDelete} disabled={isPending}>
                {isPending ? "Deleting..." : "Delete"}
              </button>
            </div>
          </div>
        </div>
      )}
      {open && <div className="slds-backdrop slds-backdrop_open"></div>}
    </>
  );
}
