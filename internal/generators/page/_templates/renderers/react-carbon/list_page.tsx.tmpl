import { [[ .ActionName ]] } from "@pola/actions";
import DeleteButton from "@/components/[[ .PluralSnake ]]/delete-button";

export default async function [[ .PluralName ]]Page({
  searchParams,
}: {
  searchParams?: Record<string, string>;
}) {
  const page = parseInt(searchParams?.page || "1", 10);
  const perPage = parseInt(searchParams?.per_page || "25", 10);
  const result = await [[ .ActionName ]].list(page, perPage);

  return (
    <div>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: "1.5rem" }}>
        <h1 style={{ fontSize: "1.25rem", fontWeight: 600, margin: 0 }}>
          [[ .PluralName ]]
        </h1>
        <a
          href="/[[ .PluralSnake ]]/create"
          className="cds--btn cds--btn--primary"
        >
          New [[ .Name ]]
        </a>
      </div>

      <div className="cds--data-table-container">
        <table className="cds--data-table cds--data-table--compact">
          <thead>
            <tr>
              <th><span className="cds--table-header-label">ID</span></th>
              [[- range .Fields ]]
              <th><span className="cds--table-header-label">[[ .Label ]]</span></th>
              [[- end ]]
              <th style={{ textAlign: "right" }}><span className="cds--table-header-label">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            {result.items.map((item) => (
              <tr key={item.id}>
                <td>{item.id}</td>
                [[- range .Fields ]]
                <td>{[[ if eq .InputType "checkbox" ]]item.[[ .JSONName ]] ? "Yes" : "No"[[ else ]]String(item.[[ .JSONName ]] ?? "")[[ end ]]}</td>
                [[- end ]]
                <td style={{ textAlign: "right" }}>
                  <div style={{ display: "inline-flex", gap: "0.5rem" }}>
                    <a href={`/[[ $.PluralSnake ]]/${item.id}`} className="cds--btn cds--btn--ghost cds--btn--sm">View</a>
                    <a href={`/[[ $.PluralSnake ]]/${item.id}/edit`} className="cds--btn cds--btn--ghost cds--btn--sm">Edit</a>
                    <DeleteButton id={item.id} />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {result.items.length === 0 && (
        <p style={{ padding: "2rem 0", textAlign: "center", color: "#525252" }}>
          No [[ .PluralSnake ]] found.
        </p>
      )}
    </div>
  );
}
