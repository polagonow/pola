"use client";

import { useState, useTransition[[ if .HasFiles ]], useRef[[ end ]] } from "react";
import { useForm, Controller } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
[[ if .HasFiles -]]
import { [[ .SnakeName ]]EditSchema, type [[ .Name ]]Edit } from "[[ .SchemaImport ]]";
[[ else -]]
import { [[ .SnakeName ]]Schema, type [[ .Name ]] } from "[[ .SchemaImport ]]";
[[ end -]]
import { csrfToken } from "@/utils/csrf";
import ThemeProvider from "@/lib/theme-provider";
import {
  Input,
  Textarea,
  Checkbox,
  Field,
  Button,
  MessageBar,
  MessageBarBody,
} from "@fluentui/react-components";

export default function Edit[[ .Name ]]Form({
  id,
  initialData,
}: {
  id: number;
[[ if .HasFiles -]]
  initialData: [[ .Name ]]Edit;
[[ else -]]
  initialData: [[ .Name ]];
[[ end -]]
}) {
  const [error, setError] = useState<string | null>(null);
  const [isPending, startTransition] = useTransition();
  const {
    register,
    handleSubmit,
    control,
    formState: { errors },
[[ if .HasFiles -]]
  } = useForm<[[ .Name ]]Edit>({
    resolver: zodResolver([[ .SnakeName ]]EditSchema),
[[ else -]]
  } = useForm<[[ .Name ]]>({
    resolver: zodResolver([[ .SnakeName ]]Schema),
[[ end -]]
    defaultValues: initialData,
  });
[[ range .FileFields ]]
  const [[ .JSONName ]]Ref = useRef<HTMLInputElement>(null);
[[- end ]]

[[ if .HasFiles -]]
  function onSubmit(data: [[ .Name ]]Edit)
[[ else -]]
  function onSubmit(data: [[ .Name ]])
[[ end -]] {
    setError(null);

    startTransition(async () => {
      try {
[[ if .HasFiles -]]
        const formData = new FormData();
        formData.append("data", JSON.stringify(data));
[[ range .FileFields ]]
        if ([[ .JSONName ]]Ref.current?.files?.[0]) {
          formData.append("[[ .JSONName ]]", [[ .JSONName ]]Ref.current.files[0]);
        }
[[- end ]]
        const res = await fetch(`/[[ .PluralSnake ]]/${id}`, {
          method: "PUT",
          headers: { "X-CSRF-Token": csrfToken() },
          body: formData,
        });
[[ else -]]
        const res = await fetch(`/[[ .PluralSnake ]]/${id}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken() },
          body: JSON.stringify(data),
        });
[[ end -]]
        if (!res.ok) {
          const text = await res.text();
          throw new Error(text || res.statusText);
        }
        window.location.href = `/[[ .PluralSnake ]]/${id}`;
      } catch (err) {
        setError(err instanceof Error ? err.message : "An error occurred");
      }
    });
  }

  return (
    <ThemeProvider>
      {error && (
        <MessageBar intent="error" style={{ marginBottom: 16 }}>
          <MessageBarBody>{error}</MessageBarBody>
        </MessageBar>
      )}

      <form onSubmit={handleSubmit(onSubmit)}>
        <div style={{ display: "flex", flexDirection: "column", gap: 20 }}>
          [[- range .Fields ]]
          [[ if eq .InputType "checkbox" -]]
          <Controller
            name="[[ .JSONName ]]"
            control={control}
            render={({ field }) => (
              <Checkbox
                checked={!!field.value}
                onChange={(_e, data) => field.onChange(data.checked)}
                label="[[ .Label ]][[ if .Optional ]] (optional)[[ end ]]"
              />
            )}
          />
          [[ else -]]
          [[ if .IsTextarea -]]
          <Field
            label="[[ .Label ]][[ if .Optional ]] (optional)[[ end ]]"
            validationMessage={errors.[[ .JSONName ]]?.message}
            validationState={errors.[[ .JSONName ]] ? "error" : "none"}
          >
            <Textarea
              id="[[ .JSONName ]]"
              {...register("[[ .JSONName ]]")}
              rows={4}
              resize="vertical"
            />
          </Field>
          [[ else -]]
          <Field
            label="[[ .Label ]][[ if .Optional ]] (optional)[[ end ]]"
            validationMessage={errors.[[ .JSONName ]]?.message}
            validationState={errors.[[ .JSONName ]] ? "error" : "none"}
          >
            <Input
              type="[[ .InputType ]]"
              id="[[ .JSONName ]]"
              {...register("[[ .JSONName ]]"[[ if eq .InputType "number" ]], { valueAsNumber: true }[[ end ]])}
              [[ if .IsFloat ]]input={{ step: "any" }}[[ end ]]
            />
          </Field>
          [[ end -]]
          [[ end -]]
          [[- end ]]
          [[- range .FileFields ]]
          <Field label="[[ .Label ]] (optional)">
            <input
              type="file"
              id="[[ .JSONName ]]"
              ref={[[ .JSONName ]]Ref}
              style={{ padding: "6px 0" }}
            />
          </Field>
          [[- end ]]
        </div>

        <div style={{ display: "flex", gap: 12, marginTop: 24 }}>
          <Button type="submit" appearance="primary" disabled={isPending}>
            {isPending ? "Saving..." : "Save [[ .Name ]]"}
          </Button>
          <Button appearance="outline" as="a" href={`/[[ .PluralSnake ]]/${id}`}>
            Cancel
          </Button>
        </div>
      </form>
    </ThemeProvider>
  );
}
