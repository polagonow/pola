"use client";

import { useState, useTransition[[ if .HasFiles ]], useRef[[ end ]] } from "react";
import { useForm, Controller } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
[[ if .HasFiles ]]import { [[ .SnakeName ]]EditSchema, type [[ .Name ]]Edit } from "[[ .SchemaImport ]]";[[ else ]]import { [[ .SnakeName ]]Schema, type [[ .Name ]] } from "[[ .SchemaImport ]]";[[ end ]]
import { csrfToken } from "@/utils/csrf";
import TextField from "@mui/material/TextField";
import Button from "@mui/material/Button";
import FormControlLabel from "@mui/material/FormControlLabel";
import Checkbox from "@mui/material/Checkbox";
import Alert from "@mui/material/Alert";
import Box from "@mui/material/Box";
import Stack from "@mui/material/Stack";

export default function Edit[[ .Name ]]Form({
  id,
  initialData,
}: {
  id: number;
  initialData: [[ if .HasFiles ]][[ .Name ]]Edit[[ else ]][[ .Name ]][[ end ]];
}) {
  const [error, setError] = useState<string | null>(null);
  const [isPending, startTransition] = useTransition();
  const {
    register,
    handleSubmit,
    control,
    formState: { errors },
  } = useForm<[[ if .HasFiles ]][[ .Name ]]Edit[[ else ]][[ .Name ]][[ end ]]>({
    resolver: zodResolver([[ if .HasFiles ]][[ .SnakeName ]]EditSchema[[ else ]][[ .SnakeName ]]Schema[[ end ]]),
    defaultValues: initialData,
  });
[[ range .FileFields ]]
  const [[ .JSONName ]]Ref = useRef<HTMLInputElement>(null);
[[- end ]]
  function onSubmit(data: [[ if .HasFiles ]][[ .Name ]]Edit[[ else ]][[ .Name ]][[ end ]]) {
    setError(null);

    startTransition(async () => {
      try {
        [[ if .HasFiles -]]
        const formData = new FormData();
        formData.append("data", JSON.stringify(data));
        [[ range .FileFields -]]
        if ([[ .JSONName ]]Ref.current?.files?.[0]) {
          formData.append("[[ .JSONName ]]", [[ .JSONName ]]Ref.current.files[0]);
        }
        [[ end -]]
        const res = await fetch(`/[[ .PluralSnake ]]/${id}`, {
          method: "PUT",
          headers: { "X-CSRF-Token": csrfToken() },
          body: formData,
        });
        [[ else -]]
        const res = await fetch(`/[[ .PluralSnake ]]/${id}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken() },
          body: JSON.stringify(data),
        });
        [[ end -]]
        if (!res.ok) {
          const text = await res.text();
          throw new Error(text || res.statusText);
        }
        window.location.href = `/[[ .PluralSnake ]]/${id}`;
      } catch (err) {
        setError(err instanceof Error ? err.message : "An error occurred");
      }
    });
  }

  return (
    <>
      {error && (
        <Alert severity="error" sx={{ mb: 2 }}>{error}</Alert>
      )}

      <form onSubmit={handleSubmit(onSubmit)}>
        <Stack spacing={2.5}>
          [[- range .Fields ]]
          [[ if eq .InputType "checkbox" -]]
          <Controller
            name="[[ .JSONName ]]"
            control={control}
            render={({ field }) => (
              <FormControlLabel
                control={
                  <Checkbox
                    checked={!!field.value}
                    onChange={(e) => field.onChange(e.target.checked)}
                  />
                }
                label="[[ .Label ]][[ if .Optional ]] (optional)[[ end ]]"
              />
            )}
          />
          [[ else -]]
          [[ if .IsTextarea -]]
          <TextField
            label="[[ .Label ]][[ if .Optional ]] (optional)[[ end ]]"
            id="[[ .JSONName ]]"
            {...register("[[ .JSONName ]]")}
            multiline
            rows={4}
            size="small"
            fullWidth
            error={!!errors.[[ .JSONName ]]}
            helperText={errors.[[ .JSONName ]]?.message}
          />
          [[ else -]]
          <TextField
            label="[[ .Label ]][[ if .Optional ]] (optional)[[ end ]]"
            type="[[ .InputType ]]"
            id="[[ .JSONName ]]"
            {...register("[[ .JSONName ]]"[[ if eq .InputType "number" ]], { valueAsNumber: true }[[ end ]])}
            [[ if .IsFloat ]]inputProps={{ step: "any" }}[[ end ]]
            size="small"
            fullWidth
            error={!!errors.[[ .JSONName ]]}
            helperText={errors.[[ .JSONName ]]?.message}
          />
          [[ end -]]
          [[ end -]]
          [[- end ]]
          [[- range .FileFields ]]
          <TextField
            type="file"
            id="[[ .JSONName ]]"
            label="[[ .Label ]]"
            inputRef={[[ .JSONName ]]Ref}
            size="small"
            fullWidth
            slotProps={{ inputLabel: { shrink: true } }}
          />
          [[- end ]]
        </Stack>

        <Box sx={{ display: "flex", gap: 1.5, mt: 3 }}>
          <Button type="submit" variant="contained" disabled={isPending}>
            {isPending ? "Saving..." : "Save [[ .Name ]]"}
          </Button>
          <Button variant="outlined" href={`/[[ .PluralSnake ]]/${id}`}>
            Cancel
          </Button>
        </Box>
      </form>
    </>
  );
}
