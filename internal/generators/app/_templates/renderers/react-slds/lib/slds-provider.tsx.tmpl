"use client";

import React, { createContext, useContext } from "react";

const IconPathContext = createContext("/assets/icons");

export function useIconPath() {
  return useContext(IconPathContext);
}

export default function SLDSProvider({ children }: { children: React.ReactNode }) {
  return (
    <IconPathContext.Provider value="/assets/icons">
      {children}
    </IconPathContext.Provider>
  );
}
