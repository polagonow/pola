{
  "name": "[[ .AppName ]]",
  "private": true,
  "scripts": {
[[- $first := true ]]
[[- if and .GenerateTests (eq .TestFramework "vitest") ]]
    [[- if $first ]][[ $first = false ]][[ else ]],[[ end ]]
    "test": "vitest run",
    "test:watch": "vitest"
[[- end ]]
[[- if and .GenerateTests (eq .TestFramework "jest") ]]
    [[- if $first ]][[ $first = false ]][[ else ]],[[ end ]]
    "test": "jest",
    "test:watch": "jest --watch"
[[- end ]]
[[- range $name, $cmd := .Scripts ]]
    [[- if $first ]][[ $first = false ]][[ else ]],[[ end ]]
    "[[ $name ]]": "[[ $cmd ]]"
[[- end ]]
  },
  "dependencies": {
    "react": "[[ index .NpmVersions "react" ]]",
    "react-dom": "[[ index .NpmVersions "react-dom" ]]",
    "react-server-dom-webpack": "[[ index .NpmVersions "react-server-dom-webpack" ]]"
    [[- range $name, $ver := .ExtraDependencies ]],
    "[[ $name ]]": "[[ $ver ]]"
    [[- end ]]
  },
  "devDependencies": {
    "@types/react": "[[ index .NpmVersions "@types/react" ]]",
    "@types/react-dom": "[[ index .NpmVersions "@types/react-dom" ]]"
[[- if and .GenerateTests (eq .TestFramework "vitest") ]],
    "vitest": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.0",
    "jsdom": "^25.0.0"
[[- end ]]
[[- if and .GenerateTests (eq .TestFramework "jest") ]],
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.0",
    "jest-environment-jsdom": "^29.7.0"
[[- end ]]
    [[- range $name, $ver := .ExtraDevDependencies ]],
    "[[ $name ]]": "[[ $ver ]]"
    [[- end ]]
    [[- if eq .CSS "tailwind" ]],
    "tailwindcss": "[[ index .NpmVersions "tailwindcss" ]]",
    "@tailwindcss/cli": "[[ index .NpmVersions "@tailwindcss/cli" ]]"
    [[- end ]]
    [[- if eq .CSS "sass" ]],
    "sass": "[[ index .NpmVersions "sass" ]]"
    [[- end ]]
  }
}
