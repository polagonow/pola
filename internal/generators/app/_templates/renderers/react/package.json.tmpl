{
  "name": "[[ .AppName ]]",
  "private": true,
  "scripts": {
[[- $first := true ]]
[[- if and .GenerateTests (eq .TestFramework "vitest") ]]
    [[- if $first ]][[ $first = false ]][[ else ]],[[ end ]]
    "test": "vitest run",
    "test:watch": "vitest"
[[- end ]]
[[- if and .GenerateTests (eq .TestFramework "jest") ]]
    [[- if $first ]][[ $first = false ]][[ else ]],[[ end ]]
    "test": "jest",
    "test:watch": "jest --watch"
[[- end ]]
[[- range $name, $cmd := .Scripts ]]
    [[- if $first ]][[ $first = false ]][[ else ]],[[ end ]]
    "[[ $name ]]": "[[ $cmd ]]"
[[- end ]]
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-server-dom-esm": "npm:@kentcdodds/tmp-react-server-dom-esm@^19.0.1",
    "react-server-dom-webpack": "19.3.0-canary-5e9eedb5-20260312"
    [[- range $name, $ver := .ExtraDependencies ]],
    "[[ $name ]]": "[[ $ver ]]"
    [[- end ]]
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
[[- if and .GenerateTests (eq .TestFramework "vitest") ]],
    "vitest": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.0",
    "jsdom": "^25.0.0"
[[- end ]]
[[- if and .GenerateTests (eq .TestFramework "jest") ]],
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.0",
    "jest-environment-jsdom": "^29.7.0"
[[- end ]]
    [[- range $name, $ver := .ExtraDevDependencies ]],
    "[[ $name ]]": "[[ $ver ]]"
    [[- end ]]
    [[- if eq .CSS "tailwind" ]],
    "tailwindcss": "^4.2.2",
    "@tailwindcss/cli": "^4.2.2"
    [[- end ]]
    [[- if eq .CSS "sass" ]],
    "sass": "^1.89.0"
    [[- end ]]
  }
}
