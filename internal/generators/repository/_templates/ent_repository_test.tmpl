package ent

import (
	"context"
	"testing"

	_ "github.com/mattn/go-sqlite3"

	"github.com/polagonow/pola/core"
	"[[.ModulePath]]/[[.EntClientDir]]"
	"[[.ModulePath]]/repositories"

	"[[.PolaPackage]]/repository"
)

// new[[.Name]]TestClient opens an in-memory SQLite-backed ent client and runs
// the schema migration. Each call creates an isolated database.
func new[[.Name]]TestClient(t *testing.T) *ent.Client {
	t.Helper()
	client, err := ent.Open("sqlite3", "file:ent_[[.SnakeName]]_test?mode=memory&cache=shared&_fk=1")
	if err != nil {
		t.Fatalf("open ent client: %v", err)
	}
	t.Cleanup(func() { client.Close() })
	if err := client.Schema.Create(context.Background()); err != nil {
		t.Fatalf("schema create: %v", err)
	}
	return client
}

// Test[[.Name]]Repository_CRUD is a wiring smoke test: it proves the entity
// round-trips through the framework-backed repository against the generated
// ent client, constructed through the DI registry. Behavioral coverage
// (pagination math, error wrapping, field dispatch) lives in the framework's
// repository conformance tests.
func Test[[.Name]]Repository_CRUD(t *testing.T) {
	if testing.Short() {
		t.Skip("integration test")
	}
	client := new[[.Name]]TestClient(t)
	r := core.NewRegistry()
	core.ProvideValue[*ent.Client](r, client)
	repo := New[[.Name]]Repository(r)
	ctx := context.Background()

	entity := &repositories.[[.Name]]{}
	if err := repo.Create(ctx, entity); err != nil {
		t.Fatalf("Create: %v", err)
	}
[[- if eq .IDGoType "string" ]]
	if entity.ID == "" {
		t.Fatal("expected ID to be set by Create")
	}
[[- else ]]
	if entity.ID == 0 {
		t.Fatal("expected ID to be set by Create")
	}
[[- end ]]
	if _, err := repo.Get(ctx, entity.ID); err != nil {
		t.Fatalf("Get: %v", err)
	}
	result, err := repo.List(ctx, repository.ListParams{Page: 1, PerPage: 10})
	if err != nil || result.Total < 1 {
		t.Fatalf("List: result=%+v err=%v", result, err)
	}
	if err := repo.Delete(ctx, entity.ID); err != nil {
		t.Fatalf("Delete: %v", err)
	}
	if _, err := repo.Get(ctx, entity.ID); err == nil {
		t.Fatal("expected Get to error after Delete")
	}
}
