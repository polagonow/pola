package gorm

import (
	"gorm.io/gorm"

	"[[.PolaPackage]]/core"
	"[[.PolaPackage]]/repository"
	gormrepo "[[.PolaPackage]]/repository/gorm"

	"[[.ModulePath]]/repositories"
[[- if eq .IDGoType "string"]]
	"github.com/google/uuid"
[[- end]]
)

// [[.LowerName]]Repository is the GORM-backed [[.Name]]Repository. The
// embedded generic implementation supplies Create/Get/List/Update/Delete;
// add custom queries as methods on this struct using r.db.
type [[.LowerName]]Repository struct {
	repository.Repository[ repositories.[[.Name]], [[.IDGoType]] ]
	db *gorm.DB
}

// New[[.Name]]Repository creates a new GORM-backed [[.Name]]Repository,
// resolving its dependencies from the DI registry.
func New[[.Name]]Repository(r *core.Registry) repositories.[[.Name]]Repository {
	db := core.MustInvoke[*gorm.DB](r)
	return &[[.LowerName]]Repository{
[[- if eq .IDGoType "string"]]
		Repository: gormrepo.New[repositories.[[.Name]], string](db, repository.WithNewID(uuid.NewString)),
[[- else]]
		Repository: gormrepo.New[repositories.[[.Name]], [[.IDGoType]]](db),
[[- end]]
		db: db,
	}
}
