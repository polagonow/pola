func (r *[[.LowerName]]Repository) List(ctx context.Context, params repositories.ListParams) (*repositories.ListResult[*repositories.[[.Name]]], error) {
	params = params.Normalize()

	total, err := r.client.[[.Name]].Query().Count(ctx)
	if err != nil {
		return nil, fmt.Errorf("count [[.PluralSnake]]: %w", err)
	}

	entries, err := r.client.[[.Name]].Query().
		Offset(params.Offset()).
		Limit(params.PerPage).
		All(ctx)
	if err != nil {
		return nil, fmt.Errorf("list [[.PluralSnake]]: %w", err)
	}

	items := make([]*repositories.[[.Name]], len(entries))
	for i, e := range entries {
		items[i] = &repositories.[[.Name]]{
[[- if eq .IDGoType "string"]]
			ID: e.ID,
[[- else]]
			ID: uint(e.ID),
[[- end]]
		[[- range $.Fields]]
			[[.Name]]: e.[[.Name]],
		[[- end]]
		}
	}

	totalPages := total / params.PerPage
	if total%params.PerPage != 0 {
		totalPages++
	}

	return &repositories.ListResult[*repositories.[[.Name]]]{
		Items:      items,
		Total:      total,
		Page:       params.Page,
		PerPage:    params.PerPage,
		TotalPages: totalPages,
	}, nil
}

