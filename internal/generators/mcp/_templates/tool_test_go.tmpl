package tools

import (
	"context"
	"testing"

	sdk "github.com/modelcontextprotocol/go-sdk/mcp"

	"github.com/polagonow/pola/core"
)

func Test[[.Name]]Tool_DescribesItself(t *testing.T) {
	r := core.NewRegistry()
	tool := New[[.Name]]Tool(r)
	descriptor := tool.Tool()
	if descriptor == nil {
		t.Fatal("Tool() returned nil")
	}
	if descriptor.Name != "[[.ToolName]]" {
		t.Fatalf("Name: got %q want %q", descriptor.Name, "[[.ToolName]]")
	}
}

func Test[[.Name]]Tool_HandleReturnsResult(t *testing.T) {
	r := core.NewRegistry()
	tool := New[[.Name]]Tool(r)
	result, err := tool.Handle(context.Background(), &sdk.CallToolRequest{})
	if err != nil {
		t.Fatalf("Handle: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result")
	}
}
