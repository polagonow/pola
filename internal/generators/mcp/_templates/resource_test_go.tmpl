package resources

import (
	"context"
	"testing"

	sdk "github.com/modelcontextprotocol/go-sdk/mcp"

	"github.com/polagonow/pola/core"
)

func Test[[.Name]]Resource_DescribesItself(t *testing.T) {
	r := core.NewRegistry()
	res := New[[.Name]]Resource(r)
	descriptor := res.Resource()
	if descriptor == nil {
		t.Fatal("Resource() returned nil")
	}
	if descriptor.URI != "[[.URI]]" {
		t.Fatalf("URI: got %q want %q", descriptor.URI, "[[.URI]]")
	}
}

func Test[[.Name]]Resource_HandleReturnsResult(t *testing.T) {
	r := core.NewRegistry()
	res := New[[.Name]]Resource(r)
	req := &sdk.ReadResourceRequest{Params: &sdk.ReadResourceParams{URI: "[[.URI]]"}}
	result, err := res.Handle(context.Background(), req)
	if err != nil {
		t.Fatalf("Handle: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result")
	}
}
