func Test[[.Name]]Service_Create_DelegatesToRepo(t *testing.T) {
	called := false
	repo := &mock[[.Name]]Repository{
		createFn: func(ctx context.Context, e *repositories.[[.Name]]) error {
			called = true
			return nil
		},
	}
	svc := New[[.Name]]Service(repo)
	if err := svc.Create(context.Background(), &repositories.[[.Name]]{}); err != nil {
		t.Fatalf("Create: %v", err)
	}
	if !called {
		t.Fatal("expected repo.Create to be called")
	}
}

func Test[[.Name]]Service_Create_PropagatesError(t *testing.T) {
	want := errors.New("boom")
	repo := &mock[[.Name]]Repository{
		createFn: func(ctx context.Context, e *repositories.[[.Name]]) error { return want },
	}
	svc := New[[.Name]]Service(repo)
	if err := svc.Create(context.Background(), &repositories.[[.Name]]{}); !errors.Is(err, want) {
		t.Fatalf("got err %v, want %v", err, want)
	}
}

func Test[[.Name]]Service_Get_DelegatesToRepo(t *testing.T) {
	want := &repositories.[[.Name]]{}
	repo := &mock[[.Name]]Repository{
		getFn: func(ctx context.Context, id [[.IDGoType]]) (*repositories.[[.Name]], error) {
			return want, nil
		},
	}
	svc := New[[.Name]]Service(repo)
[[- if eq .IDGoType "string" ]]
	got, err := svc.Get(context.Background(), "")
[[- else ]]
