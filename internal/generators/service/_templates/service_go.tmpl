package services

import (
	"github.com/polagonow/pola/core"
	"github.com/polagonow/pola/service"

	"[[.ModulePath]]/[[.ModelsDir]]"
	"[[.ModulePath]]/repositories"
)

// [[.Name]]ServiceInterface is the contract for [[.SnakeName]] business logic.
// It embeds the framework's standard CRUD service; add custom business methods
// here. Routes and other call sites depend on this interface.
type [[.Name]]ServiceInterface interface {
	service.Service[ [[.ModelsPkg]].[[.Name]], [[.IDGoType]]]
}

// [[.Name]]Service handles business logic for [[.SnakeName]] operations. The
// embedded generic service delegates CRUD to the repository; override a method
// (e.g. Create) on this struct to add validation or business rules, using
// s.repo. Add custom queries as methods here too.
type [[.Name]]Service struct {
	service.Service[ [[.ModelsPkg]].[[.Name]], [[.IDGoType]]]
	repo repositories.[[.Name]]Repository
}

// New[[.Name]]Service creates a new [[.Name]]Service, resolving its
// dependencies from the DI registry.
func New[[.Name]]Service(r *core.Registry) *[[.Name]]Service {
	repo := core.MustInvoke[repositories.[[.Name]]Repository](r)
	return &[[.Name]]Service{
		Service: service.New(repo),
		repo:    repo,
	}
}

var _ [[.Name]]ServiceInterface = (*[[.Name]]Service)(nil)
