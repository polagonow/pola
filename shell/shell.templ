package shell

import (
	"github.com/polagonow/pola/core"
)

// page is the full HTML document shell. innerHTML, importMap, and inline
// scripts are trusted framework values injected via templ.Raw().
templ page(innerHTML string, importMap string, scripts []string, clientScript string, stylesheets []string, m *core.Metadata, dp *core.DocumentProps) {
	<!DOCTYPE html>
	<html { htmlAttrs(dp)... }>
		<head>
			<meta charset={ charset(dp) }/>
			<meta name="viewport" content={ viewport(dp) }/>
			@renderMetaBlock(m)
			@customHeadElements(dp)
			if len(stylesheets) == 0 {
				@styleBlock()
			}
			for _, href := range stylesheets {
				<link rel="stylesheet" href={ href }/>
			}
			if importMap != "" {
				@templ.Raw(importMap)
			}
		</head>
		<body { bodyAttrs(dp)... }>
			@templ.Raw(bodyPrefix(dp))
			@templ.Raw(innerHTML)
			for _, sc := range scripts {
				@inlineScript(sc)
			}
			<script type="module" src={ clientScript }></script>
			@templ.Raw(bodySuffix(dp))
		</body>
	</html>
}
