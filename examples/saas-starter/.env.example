# Copy to .env and fill in. The Go server auto-loads .env (godotenv).

# JWT session signing secret (HS256). Generate one with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-32-byte-random-hex-string

# App base URL, used to build Stripe redirect URLs.
BASE_URL=http://localhost:3000

# Stripe (test mode). Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` or the webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Database ---
# Development defaults to SQLite (dev.db). For production Postgres, set:
# POLA_DATABASE_ADAPTER=postgresql
# POLA_DATABASE_URL=postgres://user:pass@localhost:5432/saas?sslmode=disable
